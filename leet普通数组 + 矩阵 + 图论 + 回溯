def generateParenthesis(n):
    res = []
    def backtrack(l, r, s):
        if l == n and r == n:
            res.append(s)
            return
        if l < n:
            backtrack(l+1, r, s + '(')
        if r < l:
            backtrack(l, r+1, s + ')')
    backtrack(0,0,"")
    return res
6. 79. 单词搜索｜中等
核心：矩阵上回溯，走过的位置临时标记，递归完撤销；四方向 DFS
python
def exist(board, word):
    m, n = len(board), len(board[0])
    dirs = [(1,0),(-1,0),(0,1),(0,-1)]
    def backtrack(i,j,idx):
        if idx == len(word):
            return True
        if i<0 or i>=m or j<0 or j>=n or board[i][j] != word[idx]:
            return False
        tmp = board[i][j]
        board[i][j] = '#' # 标记已访问
        for dx, dy in dirs:
            if backtrack(i+dx, j+dy, idx+1):
                return True
        board[i][j] = tmp # 撤销
        return False
    for i in range(m):
        for j in range(n):
            if backtrack(i,j,0):
                return True
    return False
