def permute(nums):
    res = []
    used = [False]*len(nums)
    def backtrack(path):
        if len(path)==len(nums):
            res.append(path.copy())
            return
        for i in range(len(nums)):
            if not used[i]:
                used[i]=True
                path.append(nums[i])
                backtrack(path)
                path.pop()
                used[i]=False
    backtrack([])
    return res
