def letterCombinations(digits):
    if not digits: return []
    mp = {
        '2':'abc','3':'def','4':'ghi','5':'jkl',
        '6':'mno','7':'pqrs','8':'tuv','9':'wxyz'
    }
    res = []
    def backtrack(idx, s):
        if idx == len(digits):
            res.append(s)
            return
        for c in mp[digits[idx]]:
            backtrack(idx+1, s + c)
    backtrack(0, "")
    return res
