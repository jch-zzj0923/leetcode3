1. 200. 岛屿数量｜中等
核心思路：DFS / BFS 连通块计数
遇到 '1'，岛屿 + 1，然后把相连所有 '1' 淹成 '0'，防止重复访问
python
# DFS版本
def numIslands(grid):
    m, n = len(grid), len(grid[0])
    def dfs(i,j):
        if i<0 or i>=m or j<0 or j>=n or grid[i][j]!='1':
            return
        grid[i][j] = '0'
        dfs(i+1,j)
        dfs(i-1,j)
        dfs(i,j+1)
        dfs(i,j-1)
    cnt = 0
    for i in range(m):
        for j in range(n):
            if grid[i][j] == '1':
                cnt += 1
                dfs(i,j)
    return cnt
