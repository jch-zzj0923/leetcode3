def combinationSum(candidates, target):
    res = []
    def backtrack(start, path, s):
        if s == target:
            res.append(path.copy())
            return
        if s > target:
            return
        for i in range(start, len(candidates)):
            path.append(candidates[i])
            backtrack(i, path, s + candidates[i])
            path.pop()
    backtrack(0, [], 0)
    return res
